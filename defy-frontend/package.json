{
  "name": "defy-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "mock": "node mock/server.ts",
    "real": "node real/server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "check:contracts": "node scripts/check-contracts.mjs",
    "build": "npm run check:contracts && npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "ws": "8.22.0"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0"
  }
}
